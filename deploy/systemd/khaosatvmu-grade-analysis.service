# Worker phân tích điểm học phần chạy nền: nạp điểm, gỡ kỳ, sửa ngưỡng hay bấm "Tính lại" xong là
# được tính ngay (quét lượt chờ mỗi 10 giây), không phải chạy lệnh riêng hay chờ lịch.
#
# Lúc rảnh chỉ là một truy vấn mỗi 10 giây; RAM lớn (~450 MB) chỉ trong lúc đang tính.
[Unit]
Description=Phân tích điểm học phần — chạy nền, tính ngay khi có lượt chờ
Documentation=file:///home/khaosatvmu/src/GradeAnalysisWorker/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Sửa đường dẫn này nếu repo không nằm ở /home/khaosatvmu. Docker Compose đọc .env trong thư mục làm việc.
WorkingDirectory=/home/khaosatvmu
ExecStart=/usr/bin/docker compose --profile grade-analysis run --rm grade-analysis-worker --watch --interval 10
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
