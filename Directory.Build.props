<Project>

  <!-- Không tạo API.exe: `dotnet run` chạy thẳng `dotnet exec API.dll`. -->
  <PropertyGroup>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!--
    Smart App Control nhớ hash tệp đã chặn; build tất định thì cùng mã nguồn luôn ra cùng một
    tệp nên bị chặn mãi. Ngoài Release (Configuration lúc này còn rỗng với `dotnet run`),
    mỗi lần biên dịch ra tệp mới.
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <Deterministic>false</Deterministic>
  </PropertyGroup>

</Project>
