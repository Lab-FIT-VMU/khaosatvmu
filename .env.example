# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=khaosatvmu
POSTGRES_PORT=5432

# Docker application settings
FRONTEND_BASE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
FRONTEND_PORT=8080

# Tran tai nguyen cho tung container, tinh theo may chu dich: 2 vCPU / 4 GB RAM.
# Tong mem_limit = 640 + 768 + 128 + 1536 = 3,0 GB, co y chua khoang 1 GB cho he dieu hanh
# va Docker. May to hon thi nang len, nhung DUNG de tong mem_limit vuot RAM that: het RAM thi
# kernel giet tien trinh theo thu tu kho doan, con vuot tran container thi chinh tien trinh do
# bi giet va ma thoat 137 noi ro do la loi bo nho.
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=640m
API_CPU_LIMIT=1.0
API_MEM_LIMIT=768m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=128m
# SentimentWorker giu them ~1,0 GB khi da nap model ONNX, va do la ly do no khong nam trong nhom
# khoi dong mac dinh. So nhan suy luan con dieu chinh duoc bang OPEN_COMMENT_INFERENCE_THREADS
# (mac dinh 1; xem chinh sach trong OpenCommentSentimentOptions).
SENTIMENT_CPU_LIMIT=1.0
SENTIMENT_MEM_LIMIT=1536m
# Chi co tac dung khi worker chay nen (truyen --watch).
# OPEN_COMMENT_SCAN_INTERVAL_SECONDS = do tre tu luc phieu duoc nop toi luc so lieu doi.
# OPEN_COMMENT_IDLE_UNLOAD_SECONDS = tra model lai cho he dieu hanh sau bay nhieu giay ranh;
#   0 = giu model thuong truc. Dat nho qua thi moi lan co vai y kien moi lai phai nap lai 515 MB.
OPEN_COMMENT_SCAN_INTERVAL_SECONDS=120
OPEN_COMMENT_IDLE_UNLOAD_SECONDS=120

# Email hien thi tren man hinh ho tro dang nhap (Vite build-time variable).
VITE_SUPPORT_EMAIL=kdcldhhh@vimaru.edu.vn

# Khoa ky ve "Bat dau lam bai" cua phieu khao sat.
# Phai khac nhau giua may dev va may chay that, khong commit khoa that len git.
# Doi khoa nay thi moi ve dang phat mat hieu luc: sinh vien dang lam do se bi
# tinh la 0 giay va phieu bi loc, nen tranh doi giua dot khao sat.
# Sinh khoa moi: openssl rand -base64 48
SurveyTicket__SigningKey=replace-me-with-a-long-random-string

# Optional tools profile
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=change-me
